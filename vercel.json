{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.megs.club" }],
      "destination": "https://megs.club/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.megs.club" }],
      "destination": "https://megs.club/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(webp|png|jpg|jpeg|svg|ico|woff|woff2|ttf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
