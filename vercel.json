{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "walkingfootball.app"
        }
      ],
      "destination": "https://megs.club/walking-football",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.walkingfootball.app"
        }
      ],
      "destination": "https://megs.club/walking-football",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "walkingfootball.app"
        }
      ],
      "destination": "https://megs.club/walking-football",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.walkingfootball.app"
        }
      ],
      "destination": "https://megs.club/walking-football",
      "permanent": true
    },
    {
      "source": "/leagues/scunthorpe-thursday",
      "destination": "/leagues/leisure-leagues/scunthorpe/thursday",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.megs.club"
        }
      ],
      "destination": "https://megs.club/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:all*(svg|jpg|jpeg|png|webp|ico|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/:all*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
