{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.megs.club" }],
      "destination": "https://megs.club/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:all*(svg|jpg|jpeg|png|webp|ico|woff|woff2|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/:all*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
