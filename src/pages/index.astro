---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import eddiePhoto from '../assets/eddie.png';

import miranda from '../assets/players/Miranda.jpg';
import tarabt from '../assets/players/Adel Tarabt.jpg';
import aliDia from '../assets/players/Ali Dia.jpg';
import hooper from '../assets/players/Gary Hooper.jpg';
import asprilla from '../assets/players/Asprilla.jpg';
import higuita from '../assets/players/Rene Higuita.jpg';
import kinkladze from '../assets/players/Georgi Kinkladze.jpg';
import akinfenwa from '../assets/players/Akinfenwa.jpg';
import vandenBorre from '../assets/players/Anthony Vanden Borre.jpg';
import larcos from '../assets/players/Roberto Larcos.jpg';

const heroAvatars = [
  { src: miranda, name: 'Miranda' },
  { src: tarabt, name: 'Adel Tarabt' },
  { src: aliDia, name: 'Ali Dia' },
  { src: hooper, name: 'Gary Hooper' },
  { src: asprilla, name: 'Asprilla' },
  { src: higuita, name: 'Rene Higuita' },
  { src: kinkladze, name: 'Georgi Kinkladze' },
  { src: akinfenwa, name: 'Akinfenwa' },
  { src: vandenBorre, name: 'Anthony Vanden Borre' },
  { src: larcos, name: 'Roberto Larcos' },
];

const steps = [
  { n: '01', title: 'Set it up', body: 'Create a recurring game in seconds - time, pitch, players. And automate it, if you want.', imageSrc: '/step-1-set-it-up.jpg' },
  { n: '02', title: 'Share it', body: 'Send a link. Players join and pay to play via Apple Pay or Google Pay (or cash, if you must).', imageSrc: '/step-2-share-it.png' },
  { n: '03', title: 'Teams sorted', body: 'Megs balances the sides automatically, based on player ability (that updates with each game) and how much they affect a game.', imageSrc: '/step-3-teams.jpg' },
  { n: '04', title: 'Play & track', body: 'Log the score. Ratings update. Stats build over time.' },
];

const features = [
  {
    title: 'Teams',
    body: 'Balanced every week. No bias, no debates.',
    shot: 'feature-teams',
    note: 'PNG 4:3 - balanced-teams panel slice',
    imageSrc: '/feature-teams.png',
    imageAspect: 'aspect-[1/1]',
    imagePosition: 'object-top',
  },
  {
    title: "Who's playing",
    body: "See who's in, who's out and who's on the bench. No more group-chat roll call.",
    shot: 'feature-availability',
    note: 'PNG 4:3 - IN / OUT / BENCH list slice',
    imageSrc: '/feature-availability.jpg',
    imageAspect: 'aspect-[1/1]',
    imagePosition: 'object-top',
  },
  {
    title: 'Payments',
    body: "Apple Pay, Google Pay or card. Paid before they play - no IOUs, no bank transfers, no 'who's got change?'",
    shot: 'feature-payments',
    note: 'PNG 4:3 - payments panel slice',
    imageSrc: '/feature-payments.png',
    imageAspect: 'aspect-[1/1]',
    imagePosition: 'object-top',
  },
  {
    title: 'Stats',
    body: 'Win streaks, MOTM, head-to-heads, season titles - the receipts your group chat has been crying out for.',
    shot: 'feature-stats',
    note: 'PNG 4:3 - leaderboard / form table slice',
    imageSrc: '/feature-stats.png',
    imageAspect: 'aspect-[1/1]',
    imagePosition: 'object-top',
  },
];

const navLinks = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#features', label: 'What Megs does' },
  { href: '#why', label: 'Why Megs' },
];

const testimonials = [
  {
    quote: "Stopped having to chase 14 lads every Tuesday. Best decision our group's made since switching to bibs.",
    name: "Graham",
    location: "Manchester",
  },
  {
    quote: "Teams are actually balanced now. No more 'this is rigged' messages at full time.",
    name: "Jono",
    location: "Bristol",
  },
  {
    quote: "Used to spend an hour every week sorting fives. Now it's all done before kick-off.",
    name: "Will",
    location: "Glasgow",
  },
];

const faqs = [
  {
    q: 'Is Megs really free?',
    a: "Yep, properly free. No subscription, no trial, no card on file. If you choose to collect match fees through Megs, players pay a small per-match fee on top of their share (20p platform fee and roughly 30p for the card payment processing costs) - that's how Megs keeps the lights on. The idea being, most players won't be fussed about the extra small charge for the convenience of paying via Apple Pay or Google Pay! You can still take cash or bank transfer if you'd rather organise payment yourself - you just lose the auto-tracking and ease of running thing.",
  },
  {
    q: 'Does this only work for 5-a-side, or 6s, 7s - even 11s?',
    a: "Nope, all of them. 5-a-side is the most common but Megs handles 6s, 7s, 8s and full 11-a-side games. You set the format when you create the group, and the balancing algorithm adjusts to the number of outfield players and keepers. Group sizes are flexible too - whether you're 6 deep or 14 - and popular games run a waitlist automatically once you hit capacity.",
  },
  {
    q: 'Do players need to download anything?',
    a: "Players sign up the first time they join your group (takes 30 seconds, no app required). After that, every fixture you share is a one-tap confirm and pay. The official app will be ready shortly!",
  },
  {
    q: 'How do player ratings work?',
    a: "Every player gets a starting skill rating out of 100. After each game, ratings tick up or down based on the result - small adjustments per match, so the system gets sharper the longer your group plays. On top of the headline rating, the organiser sets each player's Goal Threat (Low / Med / High) and Defensive Work Rate (Low / Med / High). Megs also spreads players around week to week, so the same crew doesn't end up on the same side every game - keeps the matchups fresh.",
  },
  {
    q: "Can players see each other's skill ratings?",
    a: "No. Only you (the organiser) can see specific ratings as you will help provide their initial skill rating, compared to other players in your group (and these scores adjust each game they play). Players see they're on a balanced team but not the numbers - no awkwardness, no group-chat fallout.",
  },
  {
    q: 'What happens if someone drops out last minute?',
    a: "When someone drops, their spot reopens automatically and waitlisted players get notified. If a replacement joins, the original gets refunded automatically. If nobody fills the spot, refunds are at your discretion as organiser.",
  },
  {
    q: 'Can I run more than one group?',
    a: "Yes. Plenty of organisers run a Tuesday and a Thursday group from the same account. Each group keeps its own players, ratings, stats and recurring fixture - all separate.",
  },
];
---

<Layout>
  <main class="bg-brand-green text-brand-black">
    <!-- ============== NAV + HERO (single bg so stripes + glow are continuous) ============== -->
    <div class="bg-pitch-glow">
      <!-- Nav -->
      <header class="px-6 pt-6 pb-4 max-w-6xl mx-auto flex items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-2 shrink-0">
          <img src="/megs-logo.svg" alt="Megs" class="h-8 w-auto" />
        </a>
        <nav class="hidden md:flex items-center gap-7 text-sm font-semibold">
          {navLinks.map(l => (
            <a href={l.href} class="hover:opacity-70 transition-opacity">{l.label}</a>
          ))}
          <a href="https://app.megs.club" class="hover:opacity-70 transition-opacity opacity-70">Log in</a>
        </nav>
        <a
          href="https://app.megs.club/create"
          class="inline-flex items-center justify-center rounded-full bg-brand-black text-brand-cream font-semibold text-sm px-5 py-2.5 hover:opacity-90 transition-opacity"
        >
          Get the app - it's free
        </a>
      </header>

      <!-- Hero -->
      <section>
        <div class="px-6 pt-10 pb-10 max-w-6xl mx-auto grid lg:grid-cols-[1.15fr_1fr] gap-12 items-center">
        <div>
          <!-- Pill tag (mono - matches app metadata style) -->
          <div class="inline-flex items-center gap-2 rounded-full bg-brand-black text-brand-cream font-scoreboard text-[11px] font-bold tracking-widest uppercase px-4 py-2 mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
            Built for the weekly kickabout
          </div>

          <!-- Hero h1 - the one true Bagel moment -->
          <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] leading-[0.95] mb-6">
            Runs your<br />five-a-side.<br />
            <span class="text-brand-orange">Roasts</span> your mates.
          </h1>

          <p class="font-body text-lg md:text-xl max-w-xl mb-8 opacity-90">
            The app for the weekly game. Megs sorts the teams, handles payments and gives your group chat the stats it's been crying out for.
          </p>

          <div class="flex flex-wrap gap-3">
            <a
              href="https://app.megs.club/create"
              class="inline-flex items-center justify-center rounded-xl bg-brand-black text-brand-cream font-semibold px-6 py-3.5 text-base shadow-brand-cream hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all"
            >
              Get your group on MEGS →
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center justify-center rounded-xl bg-brand-green border-2 border-brand-black text-brand-black font-semibold px-6 py-3.5 text-base hover:bg-brand-black hover:text-brand-cream transition-colors"
            >
              See a fixture in action
            </a>
          </div>

        </div>

        <!-- ===== Screenshot placeholder: HERO FIXTURE CARD ===== -->
        <div class="relative mx-auto w-full max-w-[280px] md:max-w-sm">
          <!-- Stat callout: celebration -->
          <div class="absolute -top-5 -left-8 z-10 rotate-3 inline-flex items-center gap-1.5 rounded-full bg-brand-black text-brand-cream font-scoreboard text-xs font-bold tracking-widest uppercase px-3.5 py-2 shadow-brand-sm">
            <span class="text-sm leading-none">🥇</span>
            Miranda: MOTM x3
          </div>

          <!-- Stat callout: roast -->
          <div class="absolute -bottom-2 -right-4 z-10 -rotate-3 inline-flex items-center gap-1.5 rounded-full bg-brand-orange text-brand-cream font-scoreboard text-xs font-bold tracking-widest uppercase px-3.5 py-2 shadow-brand-sm">
            <span class="text-sm leading-none">💀</span>
            Ali Dia: 7-loss streak
          </div>

          <!-- Hero fixture card mockup (code-built, not a screenshot) -->
          <div class="card-brand p-5 -rotate-2">
            <!-- Top metadata row -->
            <div class="flex items-center justify-between font-scoreboard text-[10px] font-bold uppercase tracking-widest text-brand-black/55 mb-3">
              <span>Tuesday · 19:00</span>
              <span>Fixture #214</span>
            </div>

            <!-- Hero title -->
            <h3 class="font-display text-[2rem] leading-[0.95] mb-4">
              Cage 3.<br />
              Kick-off in 4 hrs.
            </h3>

            <!-- Divider -->
            <div class="border-t border-dashed border-brand-black/15 mb-4"></div>

            <!-- IN/OUT count -->
            <p class="font-scoreboard text-[10px] font-bold uppercase tracking-widest text-brand-black/55 mb-3">10 in · 0 out</p>

            <!-- Player avatars -->
            <div class="flex items-center mb-5">
              {heroAvatars.map((p, i) => (
                <Image
                  src={p.src}
                  alt={p.name}
                  width={64}
                  height={64}
                  loading="eager"
                  class={`w-8 h-8 rounded-full border-2 border-brand-cream object-cover ${i > 0 ? '-ml-2' : ''}`}
                  style={`z-index: ${heroAvatars.length - i}`}
                />
              ))}
            </div>

            <!-- Auto-balanced inner panel -->
            <div class="rounded-xl border-2 border-brand-black/15 bg-brand-green/25 p-4 mb-4">
              <p class="font-scoreboard text-[10px] font-bold uppercase tracking-widest text-brand-black/55 mb-2">Teams (auto-balanced)</p>
              <div class="flex items-baseline justify-between font-display text-2xl">
                <span>Bibs</span>
                <span class="font-scoreboard text-xs tracking-widest text-brand-black/50">vs</span>
                <span>Skins</span>
              </div>
            </div>

            <!-- Payment info -->
            <div class="flex items-center justify-between text-sm font-body">
              <span class="text-brand-black/65">£6 each · paid by 9</span>
              <span class="text-brand-orange font-bold">Ali Dia owes</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Free reassurance, centered under hero -->
      <div class="px-6 pb-16 max-w-6xl mx-auto flex justify-center">
        <p class="font-scoreboard text-sm font-extrabold uppercase tracking-widest text-brand-cream flex items-center gap-2">
          <span class="text-brand-orange text-lg leading-none">✔</span>
          Free for organisers. Forever.
        </p>
      </div>
      </section>
    </div>

    <!-- ============== THE REALITY ============== -->
    <section class="bg-brand-black text-brand-cream">
      <div class="px-6 py-24 max-w-5xl mx-auto">
        <p class="font-scoreboard font-extrabold text-sm uppercase tracking-widest text-brand-orange mb-6">The reality</p>
        <h2 class="font-body font-extrabold text-4xl md:text-6xl leading-tight tracking-tight mb-12 max-w-3xl">
          Every week, it's the same story…
        </h2>

        <!-- Chat-bubble stack: original staggered left, with WhatsApp-style read ticks + timestamps -->
        <div class="space-y-2 max-w-md mb-12">
          <div class="bg-brand-cream/10 backdrop-blur-sm rounded-2xl rounded-bl-sm px-5 pt-3 pb-2 font-body">
            <p class="text-base">"Who's actually in?"</p>
            <div class="flex items-center justify-end gap-1.5 mt-1">
              <span class="text-[10px] leading-none text-brand-cream/50">18:32</span>
              <span class="text-[11px] leading-none text-[#53bdeb] tracking-[-0.4em] pr-1">✓✓</span>
            </div>
          </div>
          <div class="bg-brand-cream/10 backdrop-blur-sm rounded-2xl rounded-bl-sm px-5 pt-3 pb-2 font-body ml-6">
            <p class="text-base">"Can someone send the teams?"</p>
            <div class="flex items-center justify-end gap-1.5 mt-1">
              <span class="text-[10px] leading-none text-brand-cream/50">19:07</span>
              <span class="text-[11px] leading-none text-[#53bdeb] tracking-[-0.4em] pr-1">✓✓</span>
            </div>
          </div>
          <div class="bg-brand-cream/10 backdrop-blur-sm rounded-2xl rounded-bl-sm px-5 pt-3 pb-2 font-body ml-12">
            <p class="text-base">"Wait, has everyone paid?"</p>
            <div class="flex items-center justify-end gap-1.5 mt-1">
              <span class="text-[10px] leading-none text-brand-cream/50">19:42</span>
              <span class="text-[11px] leading-none text-[#53bdeb] tracking-[-0.4em] pr-1">✓✓</span>
            </div>
          </div>
          <div class="bg-brand-cream/10 backdrop-blur-sm rounded-2xl rounded-bl-sm px-5 pt-3 pb-2 font-body ml-20">
            <p class="text-base">"Who's got change for £6?"</p>
            <div class="flex items-center justify-end gap-1.5 mt-1">
              <span class="text-[10px] leading-none text-brand-cream/50">19:58</span>
              <span class="text-[11px] leading-none text-[#53bdeb] tracking-[-0.4em] pr-1">✓✓</span>
            </div>
          </div>
        </div>

        <p class="font-body text-lg md:text-xl mb-6 max-w-2xl">
          47 messages later and you've still got:
        </p>
        <ul class="font-body text-lg md:text-xl space-y-2 mb-12 max-w-2xl">
          <li class="flex gap-3"><span class="text-brand-orange shrink-0">×</span> uneven teams</li>
          <li class="flex gap-3"><span class="text-brand-orange shrink-0">×</span> late dropouts</li>
          <li class="flex gap-3"><span class="text-brand-orange shrink-0">×</span> someone still owed £6 since last summer</li>
          <li class="flex gap-3"><span class="text-brand-orange shrink-0">×</span> and one lad quietly stacking his own side</li>
        </ul>

        <p class="font-body font-extrabold text-3xl md:text-5xl leading-tight tracking-tight">
          You still play.<br />
          But it's chaos.
        </p>
      </div>
    </section>

    <!-- ============== THE FIX ============== -->
    <section class="bg-pitch">
      <div class="px-6 py-24 max-w-5xl mx-auto text-center">
        <p class="font-scoreboard font-extrabold text-sm uppercase tracking-widest opacity-80 mb-6">The fix</p>
        <!-- Bagel - punchline hero moment -->
        <h2 class="font-display text-5xl md:text-7xl leading-[0.95] mb-10">
          Megs runs your<br />game for you.
        </h2>
        <div class="font-body font-extrabold text-3xl md:text-4xl space-y-1 mb-10 opacity-90 tracking-tight">
          <p>No chasing.</p>
          <p>No spreadsheets.</p>
          <p>No arguments.</p>
        </div>
        <!-- Bagel - final punchline -->
        <p class="font-display text-4xl md:text-5xl text-brand-orange">
          Just turn up and play.
        </p>
      </div>
    </section>

    <!-- ============== PRICING STRIP ============== -->
    <section class="bg-brand-black text-brand-cream">
      <div class="px-6 py-16 max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full bg-brand-green text-brand-black font-scoreboard text-[11px] font-bold tracking-widest uppercase px-4 py-2 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          Pricing
        </div>
        <h2 class="font-body font-extrabold text-3xl md:text-5xl tracking-tight mb-5">
          Free for organisers. Forever.
        </h2>
        <p class="font-body text-lg md:text-xl max-w-2xl mx-auto opacity-85">
          No subscription. No trial. Players only pay a small per-match fee when you choose to collect payments through Megs.
        </p>
      </div>
    </section>

    <!-- ============== HOW IT WORKS ============== -->
    <section id="how-it-works" class="bg-brand-cream text-brand-black">
      <div class="px-6 py-24 max-w-6xl mx-auto">
        <p class="font-scoreboard font-extrabold text-sm uppercase tracking-widest opacity-70 mb-6">How it works</p>
        <h2 class="font-body font-extrabold text-4xl md:text-6xl leading-tight tracking-tight mb-16 max-w-3xl">
          From group chat to first whistle in four steps.
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {steps.map((s, i) => (
            <div class="flex flex-col-reverse md:flex-col gap-4">
              <!-- Phone screenshot (steps 1-3) / punchline card (step 4) -->
              {i < 3 && s.imageSrc && (
                <div class="card-brand p-2 overflow-hidden max-w-[280px] mx-auto md:max-w-none w-full">
                  <img
                    src={s.imageSrc}
                    alt={`${s.title} - Megs app screenshot`}
                    class="w-full h-auto block rounded-lg"
                  />
                </div>
              )}
              {i < 3 && !s.imageSrc && (
                <div
                  class="aspect-[9/19.5] rounded-2xl bg-brand-black/5 border-2 border-dashed border-brand-black/30 flex items-center justify-center text-center p-4"
                >
                  <p class="font-body text-xs text-brand-black/60 leading-relaxed">
                    PNG 9:19.5 → <code>step-{i + 1}-{s.title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')}.png</code>
                  </p>
                </div>
              )}
              {i === 3 && (
                <div
                  class="aspect-[9/19.5] card-brand bg-brand-green text-brand-black p-6 relative overflow-hidden flex items-center justify-center text-center max-w-[280px] mx-auto md:max-w-none w-full"
                >
                  <!-- Match result -->
                  <div class="absolute top-4 left-3 z-20 rotate-3 inline-flex items-center gap-1.5 rounded-full bg-brand-black text-brand-cream font-scoreboard text-[11px] font-bold tracking-widest uppercase px-3 py-1.5 shadow-brand-sm">
                    <span class="text-sm leading-none">🥊</span>
                    Bibs 6 - 4 Skins
                  </div>

                  <!-- Centerpiece -->
                  <p class="font-display text-4xl leading-[0.95] relative z-10">Game<br />on.</p>

                  <!-- Hat-trick (highlight) -->
                  <div class="absolute bottom-20 right-2 z-20 -rotate-3 inline-flex items-center gap-1.5 rounded-full bg-brand-orange text-brand-cream font-scoreboard text-[11px] font-bold tracking-widest uppercase px-3 py-1.5 shadow-brand-sm">
                    <span class="text-sm leading-none">🎩</span>
                    Joe: hat-trick
                  </div>

                  <!-- Ali Dia streak callback (7 in hero, now 8) -->
                  <div class="absolute bottom-4 left-2 z-20 -rotate-3 inline-flex items-center gap-1.5 rounded-full bg-brand-black text-brand-cream font-scoreboard text-[11px] font-bold tracking-widest uppercase px-3 py-1.5 shadow-brand-sm">
                    <span class="text-sm leading-none">💀</span>
                    Ali Dia: 8-loss streak
                  </div>
                </div>
              )}

              <div>
                <p class="font-scoreboard text-sm text-brand-orange mb-1">{s.n}</p>
                <h3 class="font-body font-extrabold text-2xl tracking-tight mb-2">{s.title}</h3>
                <p class="font-body text-sm leading-relaxed text-brand-black/75">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============== HOW BALANCING WORKS ============== -->
    <section id="balancing" class="bg-brand-cream text-brand-black">
      <div class="px-6 py-24 max-w-6xl mx-auto">
        <p class="font-scoreboard font-extrabold text-sm uppercase tracking-widest text-brand-orange mb-6">How balancing works</p>
        <h2 class="font-body font-extrabold text-4xl md:text-6xl leading-tight tracking-tight mb-16 max-w-3xl">
          Teams that get fairer every week (and nobody moans about).
        </h2>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="font-body text-lg leading-relaxed text-brand-black/85 space-y-5">
            <p>Every player has a skill rating. Megs also tracks who's a goal threat and who actually tracks back. When you set up your next game, the algorithm runs thousands of combinations to balance skill, attack and defence across both sides.</p>
            <p>Ratings update from every result, so the longer your group plays, the sharper the balancing gets. Megs even spreads the same players around week to week, so nobody ends up on the same side every game.</p>
            <p class="font-extrabold text-brand-black">No captain politics. No bias. No one quietly stacking their own team. Just teams nobody picks a fight with.</p>
          </div>

          <!-- Balancing screenshot -->
          <div class="card-brand mx-auto w-full max-w-sm p-3">
            <img
              src="/feature-balancing.jpg"
              alt="Megs perfectly balanced teams: Yellows 446 vs Oranges 448 rating, balanced across goal threat and defensive work rate, with two columns of players"
              class="w-full h-auto block rounded-lg"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============== WHAT MEGS HANDLES ============== -->
    <section id="features" class="bg-pitch">
      <div class="px-6 py-24 max-w-6xl mx-auto">
        <p class="font-scoreboard font-extrabold text-sm uppercase tracking-widest opacity-80 mb-6">What Megs handles</p>
        <h2 class="font-body font-extrabold text-4xl md:text-6xl leading-tight tracking-tight mb-16 max-w-3xl">
          Everything organising a game involves. None of the admin.
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
          {features.map(f => (
            <div class="card-brand p-6 flex flex-col gap-5">
              {f.imageSrc ? (
                <div class={`${f.imageAspect || 'aspect-[4/3]'} rounded-xl overflow-hidden bg-brand-cream`}>
                  <img
                    src={f.imageSrc}
                    alt={`${f.title} - Megs app screenshot`}
                    class={`w-full h-full object-cover ${f.imagePosition || 'object-center'}`}
                  />
                </div>
              ) : (
                <div
                  class="aspect-[4/3] rounded-xl bg-brand-black/5 border-2 border-dashed border-brand-black/30 flex items-center justify-center text-center p-4"
                >
                  <p class="font-body text-xs text-brand-black/60 leading-relaxed">
                    {f.note}<br /><code>{f.shot}.png</code>
                  </p>
                </div>
              )}
              <div>
