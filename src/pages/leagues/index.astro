---
import Layout from '../../layouts/Layout.astro';
import { getLeagues, townDay, titleCase, leaguePath, teamPath, type League } from '../../lib/leagues';

const leagues = await getLeagues();
const byTown: Record<string, League[]> = {};
for (const l of leagues) {
  const { town } = townDay(l.slug);
  (byTown[town] ??= []).push(l);
}
const towns = Object.keys(byTown).sort();

const title = 'Grassroots Football Leagues, Tables & Results | Megs';
const description = 'Find your local grassroots football league - tables, results and player stats by town. Claim your team’s free page on Megs.';
---

<Layout title={title} description={description}>
  <main class="bg-pitch page">
    <div class="wrap">
      <header class="hdr">
        <a class="brand" href="https://megs.club"><img src="/megs-logo.svg" alt="Megs" height="30" /></a>
        <h1 class="disp h1">Find your league</h1>
        <p class="sub">Tables, results and player stats for local grassroots football. Search for your town, league or team.</p>
        <input id="search" type="search" placeholder="Search town, league or team…" autocomplete="off" class="search" />
      </header>

      {towns.map((town) => (
        <section class="town-sec" data-town={town}>
          <p class="sec-label">📍 {titleCase(town)}</p>
          <div class="grid">
            {byTown[town].map((l) => (
              <div class="lcard" data-search={`${town} ${l.name} ${l.provider} ${l.teams.map((t) => t.name).join(' ')}`.toLowerCase()}>
                <div class="ltop">
                  <a class="lname disp" href={leaguePath(l)}>{l.name}</a>
                  <span class="ptag">{titleCase(l.provider)}</span>
                </div>
                <div class="lmeta">{l.venue} · {l.teams.length} teams</div>
                <div class="teams">
                  {l.teams.map((t) => <a class="tlink" href={teamPath(l, t.name)}>{t.name}</a>)}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <p id="noresults" class="noresults">No leagues match - try a different town or team.</p>
      {leagues.length === 0 && <p class="sub">Leagues coming soon.</p>}

      <footer class="foot">A Megs directory of grassroots football. <a href="https://megs.club">megs.club</a></footer>
    </div>
  </main>
</Layout>

<script is:inline>
  const input = document.getElementById('search');
  const none = document.getElementById('noresults');
  input && input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let any = false;
    document.querySelectorAll('.town-sec').forEach((sec) => {
      let shown = 0;
      sec.querySelectorAll('.lcard').forEach((card) => {
        const match = !q || (card.dataset.search || '').includes(q);
        card.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      sec.style.display = shown ? '' : 'none';
      if (shown) any = true;
    });
    if (none) none.style.display = any ? 'none' : 'block';
  });
</script>

<style>
  .page { min-height: 100vh; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px 72px; }
  .disp { font-family: var(--font-display); font-weight: 400; }
  .hdr { padding: 24px 0 6px; }
  .brand { display: inline-block; margin-bottom: 22px; }
  .brand img { display: block; height: 30px; width: auto; }
  .h1 { font-size: clamp(32px, 8vw, 50px); line-height: 0.98; color: #fff; margin: 0 0 12px; text-shadow: 0 2px 0 rgba(14,15,12,0.18); }
  .sub { color: rgba(14,15,12,0.78); font-size: 15.5px; max-width: 52ch; margin: 0; }
  .search { margin-top: 18px; width: 100%; height: 48px; padding: 0 18px; font-family: var(--font-body); font-size: 16px; color: var(--color-brand-black); background: var(--color-brand-cream); border: 2px solid var(--color-brand-black); border-radius: 12px; box-shadow: var(--shadow-brand-sm); outline: none; }
  .search::placeholder { color: rgba(14,15,12,0.5); }
  section { margin-top: 26px; }
  .sec-label { font-family: var(--font-scoreboard); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-brand-black); opacity: 0.6; margin: 0 0 12px; padding-left: 2px; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 640px) { .grid { grid-template-columns: 1fr 1fr; } }
  .lcard { background: var(--color-brand-cream); border: 2px solid var(--color-brand-black); box-shadow: var(--shadow-brand); border-radius: 16px; padding: 16px 18px; }
  .ltop { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .lname { font-size: 19px; color: var(--color-brand-black); text-decoration: none; }
  .lname:hover { text-decoration: underline; }
  .ptag { flex: none; font-family: var(--font-scoreboard); font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-brand-deep); background: rgba(14,92,46,0.1); border-radius: 20px; padding: 3px 8px; }
  .lmeta { font-size: 12.5px; color: rgba(14,15,12,0.6); margin: 2px 0 10px; }
  .teams { display: flex; flex-wrap: wrap; gap: 6px; }
  .teams .tlink { font-size: 12.5px; font-weight: 600; background: #EDE6D2; border: 1.5px solid var(--color-brand-black); border-radius: 20px; padding: 4px 10px; text-decoration: none; color: var(--color-brand-black); }
  .teams .tlink:hover { background: var(--color-brand-green); }
  .noresults { display: none; color: rgba(14,15,12,0.7); font-size: 15px; margin-top: 20px; }
  .foot { margin-top: 34px; text-align: center; color: rgba(14,15,12,0.55); font-size: 11.5px; }
  .foot a { color: var(--color-brand-black); }
</style>
