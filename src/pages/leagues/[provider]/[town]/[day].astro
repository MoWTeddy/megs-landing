---
import Layout from '../../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getLeagues, townDay, providerSlug, titleCase, type League } from '../../../../lib/leagues';

// Illustrative stat leaders - cult "streets won't forget" legends, using the
// site's own player artwork. This is the "what you'd get on Megs" teaser, not
// real league data (there is none until a team claims and plays on Megs).
import kinkladze from '../../../../assets/players/Georgi Kinkladze.jpg';
import asprilla from '../../../../assets/players/Asprilla.jpg';
import akinfenwa from '../../../../assets/players/Akinfenwa.jpg';
import hooper from '../../../../assets/players/Gary Hooper.jpg';
import higuita from '../../../../assets/players/Rene Higuita.jpg';
import tarabt from '../../../../assets/players/Adel Tarabt.jpg';
import vandenBorre from '../../../../assets/players/Anthony Vanden Borre.jpg';

export async function getStaticPaths() {
  const leagues = await getLeagues();
  return leagues.map((league) => {
    const { town, day } = townDay(league.slug);
    return { params: { provider: providerSlug(league.provider), town, day }, props: { league } };
  });
}

const { league } = Astro.props as { league: League };
const providerName = titleCase(league.provider);
const claimedCount = league.teams.filter((t) => t.claimed).length;
const total = league.teams.length;
const gd = (n: number) => (n > 0 ? `+${n}` : `${n}`);
const marker = (pos: number) => (pos <= 2 ? 'var(--color-brand-green)' : pos >= total - 1 ? '#C0392B' : 'transparent');

const scorers = [{ img: asprilla, n: 'Asprilla', v: 11 }, { img: akinfenwa, n: 'Akinfenwa', v: 8 }, { img: hooper, n: 'Gary Hooper', v: 6 }];
const assists = [{ img: higuita, n: 'Higuita', v: 9 }, { img: tarabt, n: 'Tarabt', v: 7 }, { img: vandenBorre, n: 'Vanden Borre', v: 5 }];

const APP = 'https://app.megs.club';
const APP_STORE = 'https://apps.apple.com/app/megs/id6783225149';
const PLAY = 'https://play.google.com/store/apps/details?id=club.megs.app';

const title = `${league.name} - Table, Results & Player Stats | Megs`;
const description = `The ${league.name} at ${league.venue}: live table, results and player stats. Is it your team? Claim your free page on Megs.`;
---

<Layout title={title} description={description}>
  <main class="bg-pitch page">
    <div class="wrap">

      <header class="hdr">
        <a class="brand" href="https://megs.club"><img src="/megs-logo.svg" alt="Megs" width="88" height="32" /></a>
        <p class="eyebrow">{providerName} · {titleCase(townDay(league.slug).town)}</p>
        <h1 class="disp h1">{league.name}</h1>
        <div class="chips">
          <span class="chip">{league.venue}</span>
          <span class="chip">{league.division}</span>
          <span class="chip live"><span class="pulse"></span> Updated weekly</span>
        </div>
      </header>

      <div class="claim-banner">
        <div>
          <div class="cb-t disp">{claimedCount > 0 ? `${claimedCount} of ${total} already on Megs` : 'Is one of these your team?'}</div>
          <div class="cb-s">{claimedCount > 0 ? "Don't let your rivals get the bragging rights. Claim yours free." : 'Claim your free page - table, results and player stats, all yours.'}</div>
        </div>
        <a class="btn btn-orange" href={APP}>Claim your team</a>
      </div>

      <section>
        <p class="sec-label">League table</p>
        <div class="card-brand tcard">
          <div class="tscroll">
            <table>
              <thead><tr>
                <th class="c-pos">#</th>
                <th class="c-team">Team</th>
                <th class="c-num">P</th>
                <th class="c-num d-sm">W</th><th class="c-num d-sm">D</th><th class="c-num d-sm">L</th>
                <th class="c-num d-sm">F</th><th class="c-num d-sm">A</th>
                <th class="c-num">GD</th><th class="c-num pr">Pts</th>
              </tr></thead>
              <tbody>
                {league.teams.map((r) => (
                  <tr class={r.claimed ? 'claimed' : ''}>
                    <td class="c-pos pos">{r.position}</td>
                    <td class="c-team team">
                      <span class="mk" style={`background:${marker(r.position)}`}></span>
                      <span class="tn">{r.name}</span>
                      {r.claimed
                        ? <span class="on-megs">✓ On Megs</span>
                        : <a class="cl" href={APP}>Claim ›</a>}
                    </td>
                    <td class="c-num">{r.p}</td>
                    <td class="c-num d-sm">{r.w}</td><td class="c-num d-sm">{r.d}</td><td class="c-num d-sm">{r.l}</td>
                    <td class="c-num d-sm">{r.f}</td><td class="c-num d-sm">{r.a}</td>
                    <td class={`c-num ${r.gd > 0 ? 'gdp' : r.gd < 0 ? 'gdn' : ''}`}>{gd(r.gd)}</td>
                    <td class="c-num pr pts disp">{r.pts}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="note">Standings from public {providerName} data{claimedCount > 0 ? ` · ${claimedCount} team${claimedCount > 1 ? 's' : ''} already claimed on Megs` : ''}.</p>
      </section>

      <section>
        <p class="sec-label">The bit the table's missing</p>
        <div class="card-brand pad">
          <h2 class="disp h2">Every player gets their own stats</h2>
          <p class="lede">The league site gives you eight numbers in a row. On Megs your team gets goals, assists, Man of the Match, appearances - the stuff that actually starts arguments.</p>

          <div class="potm">
            <Image src={kinkladze} alt="Kinkladze" width={56} height={56} class="av" />
            <div class="who"><div class="tag">Player of the Season</div><div class="nm disp">Kinkladze</div></div>
            <div class="pb"><div class="pn disp">248</div><div class="pk">points</div></div>
          </div>

          <div class="lg">
            <div class="lead">
              <h4>⚽ Top scorers</h4>
              {scorers.map((s, i) => (
                <div class="lr"><span class="r">{i + 1}</span><Image src={s.img} alt={s.n} width={28} height={28} class="pi" /><span class="p">{s.n}</span><span class="v disp">{s.v}</span></div>
              ))}
            </div>
            <div class="lead">
              <h4>🅰 Most assists</h4>
              {assists.map((s, i) => (
                <div class="lr"><span class="r">{i + 1}</span><Image src={s.img} alt={s.n} width={28} height={28} class="pi" /><span class="p">{s.n}</span><span class="v disp">{s.v}</span></div>
              ))}
            </div>
          </div>

          <div class="duo">🔥 Deadly duo &nbsp;<b class="disp">Higuita → Asprilla</b>&nbsp; · 6 link-ups this season</div>
          <div class="chipset">
            <span>🧤 Man of the Match</span><span>🔗 Chemistry</span><span>👯 Deadly duos</span>
            <span>📅 Appearances</span><span>📈 Form</span><span>🏆 Player of the Season</span><span>📲 Shareable cards</span>
          </div>
          <p class="missing"><b>None of which</b> the league table gives you - and it's all your players', to see and share.</p>
        </div>
      </section>

      <section>
        <p class="sec-label">Claiming = your whole matchday</p>
        <div class="card-brand pad">
          <div class="bgrid">
            <div class="bi"><span class="ic">⚖️</span><div><b>Balanced teams</b><span>Auto-picked fair, every week</span></div></div>
            <div class="bi"><span class="ic">💸</span><div><b>Match fees</b><span>Collect by card or cash</span></div></div>
            <div class="bi"><span class="ic">✅</span><div><b>Availability</b><span>Who's in and who's out, sorted</span></div></div>
            <div class="bi"><span class="ic">📊</span><div><b>Table + stats</b><span>Updated automatically</span></div></div>
          </div>
        </div>
      </section>

      <div class="card-brand explain">
        <h2 class="disp h2b">Claim your team, free</h2>
        <p>Recognise your side? Claim your page and your table, results and history come straight into Megs - where you pick teams, take payments and settle who's actually carrying the side, all from your phone.</p>
        <a class="btn btn-orange big" href={APP}>Claim your team →</a>
        <div class="perks">
          <span>⚡ <b>Nothing to migrate</b> - it's already here</span>
          <span>💸 <b>Free</b> to claim</span>
          <span>📲 <b>Run it from your phone</b></span>
        </div>
        <div class="stores">
          <a href={APP_STORE} aria-label="Download on the App Store"><img src="/appstore-badge.svg" alt="Download on the App Store" height="44" /></a>
          <a href={PLAY} aria-label="Get it on Google Play"><img src="/googleplay-badge.svg" alt="Get it on Google Play" height="44" /></a>
        </div>
      </div>

      <footer class="foot">
        A Megs page for grassroots football. Results are public league data; player stats shown are an example of what Megs tracks.<br>
        Not affiliated with {providerName}. <a href="https://megs.club">megs.club</a>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .page { min-height: 100vh; }
  .wrap { max-width: 680px; margin: 0 auto; padding: 0 16px 72px; }
  .disp { font-family: var(--font-display); font-weight: 400; }

  .hdr { padding: 22px 0 4px; }
  .brand { display: inline-block; margin-bottom: 24px; }
  .brand img { display: block; height: 30px; width: auto; }
  .eyebrow { font-family: var(--font-scoreboard); font-weight: 700; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-brand-deep); margin: 0 0 10px; }
  .h1 { font-size: clamp(32px, 8.5vw, 52px); line-height: 0.98; color: #fff; margin: 0 0 14px; text-shadow: 0 2px 0 rgba(14,15,12,0.18); }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; }
  .chip { font-family: var(--font-scoreboard); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; background: var(--color-brand-black); color: var(--color-brand-cream); padding: 5px 10px; border-radius: 20px; }
  .chip.live { background: var(--color-brand-cream); color: var(--color-brand-deep); display: inline-flex; align-items: center; gap: 6px; }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--color-brand-deep); animation: pulse 2s infinite; }
  @keyframes pulse { 0%{box-shadow:0 0 0 0 rgba(14,92,46,.5)} 70%{box-shadow:0 0 0 6px rgba(14,92,46,0)} 100%{box-shadow:0 0 0 0 rgba(14,92,46,0)} }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }

  section { margin-top: 26px; }
  .sec-label { font-family: var(--font-scoreboard); font-weight: 700; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-brand-black); opacity: 0.55; margin: 0 0 10px; padding-left: 2px; }
  .pad { padding: 20px; }
  .note { font-size: 12px; color: rgba(14,15,12,0.55); margin: 10px 2px 0; }

  .btn { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-display); font-size: 15px; border: 2px solid var(--color-brand-black); border-radius: 12px; padding: 10px 18px; text-decoration: none; white-space: nowrap; }
  .btn-orange { background: var(--color-brand-orange); color: #fff; box-shadow: var(--shadow-brand-sm); }
  .btn-orange:active { transform: translate(2px,2px); box-shadow: none; }
  .big { font-size: 17px; padding: 13px 26px; }

  .claim-banner { margin-top: 22px; background: var(--color-brand-black); border: 2px solid var(--color-brand-black); border-radius: 16px; padding: 16px 18px; box-shadow: var(--shadow-brand-cream); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .cb-t { font-size: 17px; color: var(--color-brand-cream); }
  .cb-s { color: rgba(244,239,224,0.62); font-size: 13px; margin-top: 2px; }

  /* table - team hard-left, numbers hard-right */
  .tcard { overflow: hidden; padding: 4px 6px; }
  .tscroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 14.5px; }
  th { font-family: var(--font-scoreboard); font-weight: 700; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.04em; color: rgba(14,15,12,0.6); padding: 12px 8px; border-bottom: 2px solid var(--color-brand-black); }
  td { padding: 13px 8px; border-bottom: 1px solid rgba(14,15,12,0.12); font-variant-numeric: tabular-nums; }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: rgba(14,15,12,0.04); }
  tbody tr.claimed { background: rgba(43,208,107,0.12); }
  .c-pos { width: 30px; text-align: left; }
  th.c-team, td.c-team { text-align: left; width: 100%; }
  .c-num { text-align: right; white-space: nowrap; }
  .pr { padding-right: 14px; }
  .pos { font-weight: 800; color: rgba(14,15,12,0.6); }
  .tn { font-weight: 700; letter-spacing: -0.01em; }
  .mk { display: inline-block; width: 3px; height: 15px; border-radius: 2px; vertical-align: middle; margin-right: 9px; }
  .pts { font-size: 16px; }
  .gdp { color: var(--color-brand-deep); font-weight: 700; } .gdn { color: #C0392B; font-weight: 700; }
  .cl { display: inline-block; font-family: var(--font-scoreboard); font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-brand-deep); margin-left: 9px; text-decoration: none; opacity: 0; transition: opacity .12s; }
  tr:hover .cl { opacity: 1; }
  @media (hover: none) { .cl { opacity: 1; } }
  .on-megs { display: inline-block; margin-left: 9px; font-family: var(--font-scoreboard); font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; color: #fff; background: var(--color-brand-deep); padding: 2px 8px; border-radius: 20px; vertical-align: middle; }
  @media (max-width: 520px) { .d-sm { display: none; } }

  /* stats */
  .h2 { font-size: clamp(22px, 5.5vw, 28px); margin: 0 0 4px; }
  .lede { color: rgba(14,15,12,0.62); font-size: 14.5px; margin: 0 0 20px; max-width: 42ch; }
  .potm { display: flex; align-items: center; gap: 14px; background: var(--color-brand-green); border: 2px solid var(--color-brand-black); border-radius: 14px; padding: 12px 16px; margin-bottom: 16px; }
  .av { width: 56px; height: 56px; border-radius: 12px; border: 2px solid var(--color-brand-black); object-fit: cover; flex: none; }
  .who { flex: 1; min-width: 0; }
  .tag { font-family: var(--font-scoreboard); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-brand-deep); }
  .nm { font-size: 20px; line-height: 1.1; }
  .pb { text-align: center; flex: none; }
  .pn { font-size: 26px; line-height: 1; }
  .pk { font-family: var(--font-scoreboard); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(14,15,12,0.6); }
  .lg { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 480px) { .lg { grid-template-columns: 1fr; } }
  .lead { background: #EDE6D2; border: 2px solid var(--color-brand-black); border-radius: 12px; padding: 12px 14px; }
  .lead h4 { font-family: var(--font-scoreboard); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 8px; }
  .lr { display: flex; align-items: center; gap: 9px; padding: 5px 0; font-size: 14px; }
  .lr .r { width: 12px; color: rgba(14,15,12,0.45); font-weight: 800; font-size: 12px; }
  .pi { width: 28px; height: 28px; border-radius: 8px; border: 1.5px solid var(--color-brand-black); object-fit: cover; flex: none; }
  .lr .p { flex: 1; font-weight: 600; }
  .lr .v { font-size: 15px; }
  .duo { margin-top: 16px; background: var(--color-brand-black); color: var(--color-brand-cream); border-radius: 12px; padding: 11px 14px; font-size: 13.5px; font-weight: 600; }
  .duo b { color: var(--color-brand-green); font-weight: 400; }
  .chipset { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .chipset span { font-size: 12.5px; font-weight: 600; background: #EDE6D2; border: 1.5px solid var(--color-brand-black); border-radius: 20px; padding: 5px 11px; }
  .missing { margin-top: 16px; font-size: 13px; color: rgba(14,15,12,0.62); }
  .missing b { color: var(--color-brand-black); }

  .bgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 460px) { .bgrid { grid-template-columns: 1fr; } }
  .bi { display: flex; gap: 11px; align-items: flex-start; }
  .bi .ic { font-size: 21px; line-height: 1.15; flex: none; }
  .bi b { display: block; font-size: 14.5px; letter-spacing: -0.01em; }
  .bi span { font-size: 12.5px; color: rgba(14,15,12,0.62); }

  .explain { margin-top: 30px; padding: 30px 22px; text-align: center; }
  .h2b { font-size: clamp(26px, 6.5vw, 34px); margin: 0 0 10px; }
  .explain p { color: rgba(14,15,12,0.62); max-width: 44ch; margin: 0 auto 20px; font-size: 15px; }
  .perks { display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: center; margin-top: 20px; font-size: 12.5px; color: rgba(14,15,12,0.62); }
  .perks b { color: var(--color-brand-deep); }
  .stores { display: flex; gap: 12px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
  .stores img { display: block; height: 44px; width: auto; }

  .foot { margin-top: 34px; text-align: center; color: rgba(14,15,12,0.55); font-size: 11.5px; line-height: 1.8; }
  .foot a { color: var(--color-brand-black); }
</style>
